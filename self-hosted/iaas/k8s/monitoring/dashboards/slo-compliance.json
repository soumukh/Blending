{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, pod) (rate(http_request_duration_seconds_bucket{namespace=\"default\"}[10m]))) * 1000",
          "legendFormat": "{{pod}}"
        },
        {
          "expr": "vector(500)",
          "legendFormat": "500ms SLO"
        }
      ],
      "title": "p99 Latency SLO",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 2,
      "targets": [
        {
          "expr": "100 * sum by (pod) (rate(http_requests_total{namespace=\"default\",status=~\"5..\"}[10m])) / sum by (pod) (rate(http_requests_total{namespace=\"default\"}[10m]))",
          "legendFormat": "{{pod}}"
        },
        {
          "expr": "vector(0.1)",
          "legendFormat": "0.1% error SLO"
        }
      ],
      "title": "Error Rate SLO",
      "type": "timeseries"
    }
  ],
