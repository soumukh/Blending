      "id": 1,
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[1m])) * 100",
          "legendFormat": "{{pod}}"
        }
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (function_name) (rate(gateway_function_invocation_total[1m]))",
          "legendFormat": "{{function_name}}"
        }
      ],
      "title": "OpenFaaS Invocation Rate",
      "type": "timeseries"
    }
  ],
